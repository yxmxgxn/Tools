{
  "name": "tools",
  "compatibility_date": "2026-08-26",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/sns-account-lookup/api"]
  },
  // 投稿URLからアカウントを調べるAPIの回数制限（worker/index.js が使う）。
  // 1人あたり60秒に8回、全体で60秒に120回まで。拠点ごとの数え上げなので、きっちりした数ではない
  "ratelimits": [
    { "name": "LOOKUP_LIMITER", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } },
    { "name": "LOOKUP_GLOBAL", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ]
}
